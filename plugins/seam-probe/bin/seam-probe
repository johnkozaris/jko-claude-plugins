#!/bin/sh
# bin/seam-probe — thin wrapper for the bundled Rust binary.
#
# The probe is built automatically by the plugin's SessionStart hook
# into ${CLAUDE_PLUGIN_DATA}/target/release/seam-probe. If the build
# is still in progress (fresh install) or failed, this wrapper prints
# a short hint pointing at /seam-probe:seam-probe-setup.

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PLUGIN_ROOT=${CLAUDE_PLUGIN_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}
DATA_DIR=${CLAUDE_PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/seam-probe}
BIN=$DATA_DIR/target/release/seam-probe

if [ ! -x "$BIN" ]; then
  cat >&2 <<EOF
seam-probe is not built yet.

The plugin auto-builds on session start; if this is a fresh install,
the build may still be running — try again in a few seconds.

If the auto-build failed, run /seam-probe:seam-probe-setup for verbose output, or
build directly:

  (cd "$PLUGIN_ROOT" && \\
    cargo build --release --locked \\
      --manifest-path crate/Cargo.toml \\
      --target-dir "$DATA_DIR/target")

Rust 1.97.1 is required (https://www.rust-lang.org/tools/install).
EOF
  exit 1
fi

exec "$BIN" "$@"
